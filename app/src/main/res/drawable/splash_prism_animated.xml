<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon: AntiElite hexagonal crest & "A" core animated -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <!-- Ambient glow -->
            <group
                android:name="glow"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.7"
                android:scaleY="0.7">
                <path
                    android:name="glow_path"
                    android:fillAlpha="0.3"
                    android:pathData="M24,54a30,30 0,1 0,60 0a30,30 0,1 0,-60 0Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="radial"
                            android:centerX="54"
                            android:centerY="54"
                            android:gradientRadius="30"
                            android:startColor="#7038BDF8"
                            android:endColor="#0038BDF8" />
                    </aapt:attr>
                </path>
            </group>

            <!-- Hex crest -->
            <group
                android:name="crest"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.92"
                android:scaleY="0.92">
                <path
                    android:fillColor="#E60B101C"
                    android:pathData="M54,29L75.6,41.5L75.6,66.5L54,79L32.4,66.5L32.4,41.5Z" />

                <path
                    android:fillType="evenOdd"
                    android:pathData="M54,27.5L77,40.8L77,67.2L54,80.5L31,67.2L31,40.8ZM54,30.8L33.9,42.4L33.9,65.6L54,77.2L74.1,65.6L74.1,42.4Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="31"
                            android:startY="28"
                            android:endX="77"
                            android:endY="80">
                            <item android:offset="0" android:color="#FF38BDF8" />
                            <item android:offset="0.5" android:color="#FF818CF8" />
                            <item android:offset="1" android:color="#FFC084FC" />
                        </gradient>
                    </aapt:attr>
                </path>

                <path android:pathData="M54,38L42,66.5L48,66.5L54,50.8Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="42"
                            android:startY="38"
                            android:endX="54"
                            android:endY="66.5"
                            android:startColor="#FFFFFFFF"
                            android:endColor="#FFC8D4E6" />
                    </aapt:attr>
                </path>

                <path android:pathData="M54,38L66,66.5L60,66.5L54,50.8Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="54"
                            android:startY="38"
                            android:endX="66"
                            android:endY="66.5"
                            android:startColor="#FFE2E8F0"
                            android:endColor="#FF7C8CA6" />
                    </aapt:attr>
                </path>

                <path android:pathData="M43.2,58.8L64.8,53.2L63.4,57.4L41.8,63Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="41.8"
                            android:startY="60.5"
                            android:endX="64.8"
                            android:endY="54.5">
                            <item android:offset="0" android:color="#FF22D3EE" />
                            <item android:offset="0.5" android:color="#FFFFFFFF" />
                            <item android:offset="1" android:color="#FFA855F7" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="crest">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="450"
                    android:valueFrom="0.92"
                    android:valueTo="1"
                    android:interpolator="@interpolator/splash_ease" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="450"
                    android:valueFrom="0.92"
                    android:valueTo="1"
                    android:interpolator="@interpolator/splash_ease" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="glow">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="600"
                    android:valueFrom="0.7"
                    android:valueTo="1.05"
                    android:repeatCount="1"
                    android:repeatMode="reverse"
                    android:interpolator="@interpolator/splash_soft" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="600"
                    android:valueFrom="0.7"
                    android:valueTo="1.05"
                    android:repeatCount="1"
                    android:repeatMode="reverse"
                    android:interpolator="@interpolator/splash_soft" />
            </set>
        </aapt:attr>
    </target>

</animated-vector>
